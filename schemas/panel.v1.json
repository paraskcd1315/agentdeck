{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentdeck.dev/schemas/panel.v1.json",
  "title": "AgentDeck Panel v1",
  "type": "object",
  "required": ["schema", "title", "blocks"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "panel/v1" },
    "title": { "type": "string", "minLength": 1 },
    "blocks": {
      "type": "array",
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/markdownBlock" },
        { "$ref": "#/$defs/keyValueBlock" },
        { "$ref": "#/$defs/statusBlock" },
        { "$ref": "#/$defs/actionsBlock" },
        { "$ref": "#/$defs/tableBlock" },
        { "$ref": "#/$defs/diffBlock" },
        { "$ref": "#/$defs/stepsBlock" },
        { "$ref": "#/$defs/logBlock" },
        { "$ref": "#/$defs/chartBlock" }
      ]
    },
    "markdownBlock": {
      "type": "object",
      "required": ["type", "text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "markdown" },
        "text": { "type": "string" }
      }
    },
    "keyValueBlock": {
      "type": "object",
      "required": ["type", "rows"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "keyvalue" },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "value"],
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        }
      }
    },
    "statusBlock": {
      "type": "object",
      "required": ["type", "state", "text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "status" },
        "state": { "enum": ["idle", "working", "waiting", "failed"] },
        "text": { "type": "string" }
      }
    },
    "actionsBlock": {
      "type": "object",
      "required": ["type", "buttons"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "actions" },
        "buttons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "prompt"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "prompt": { "type": "string" },
              "target": { "enum": ["live", "new"], "default": "live" }
            }
          }
        }
      }
    },
    "tableBlock": {
      "type": "object",
      "required": ["type", "columns", "rows"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "table" },
        "columns": { "type": "array", "items": { "type": "string" } },
        "rows": {
          "type": "array",
          "items": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "diffBlock": {
      "type": "object",
      "required": ["type", "file", "lines"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "diff" },
        "file": { "type": "string" },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "text"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["context", "add", "delete", "hunk"] },
              "text": { "type": "string" }
            }
          }
        }
      }
    },
    "stepsBlock": {
      "type": "object",
      "required": ["type", "steps"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "steps" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "state"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "state": { "enum": ["pending", "active", "done", "failed"] }
            }
          }
        }
      }
    },
    "logBlock": {
      "type": "object",
      "required": ["type", "entries"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "log" },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["level", "text"],
            "additionalProperties": false,
            "properties": {
              "level": { "enum": ["trace", "debug", "info", "warn", "error", "fatal"] },
              "text": { "type": "string" },
              "time": { "type": "string" }
            }
          }
        }
      }
    },
    "chartBlock": {
      "type": "object",
      "required": ["type", "kind", "labels", "series"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "chart" },
        "kind": { "enum": ["bar", "line"] },
        "labels": { "type": "array", "items": { "type": "string" } },
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "points"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "points": { "type": "array", "items": { "type": "number" } }
            }
          }
        }
      }
    }
  }
}
