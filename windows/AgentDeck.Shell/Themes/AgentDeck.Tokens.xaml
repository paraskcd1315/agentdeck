<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="AdBrand300">#F7CE6B</Color>
            <Color x:Key="AdBrand400">#F0BE4A</Color>
            <Color x:Key="AdBrand500">#E5A82B</Color>
            <Color x:Key="AdBrand600">#C88A1C</Color>
            <Color x:Key="AdBrand700">#A06B15</Color>
            <Color x:Key="AdAccent300">#6FA06B</Color>
            <Color x:Key="AdAccent400">#5C8C58</Color>
            <Color x:Key="AdAccent500">#4E7A4E</Color>

            <Color x:Key="AdBgBase">#0E0F12</Color>
            <Color x:Key="AdSurface">#16181D</Color>
            <Color x:Key="AdSurfaceContainer">#1D2027</Color>
            <Color x:Key="AdSurfaceContainerHigh">#252932</Color>
            <Color x:Key="AdTermBg">#0B0C0F</Color>
            <Color x:Key="AdTermFg">#D6D9E0</Color>

            <SolidColorBrush x:Key="AdTextPrimaryBrush" Color="White" Opacity="0.93" />
            <SolidColorBrush x:Key="AdTextSecondaryBrush" Color="White" Opacity="0.60" />
            <SolidColorBrush x:Key="AdTextTertiaryBrush" Color="White" Opacity="0.38" />
            <SolidColorBrush x:Key="AdBorderBrush" Color="White" Opacity="0.13" />
            <SolidColorBrush x:Key="AdBorderStrongBrush" Color="White" Opacity="0.20" />
            <SolidColorBrush x:Key="AdGlassBrush" Color="{StaticResource AdSurface}" Opacity="0.62" />
            <SolidColorBrush x:Key="AdGlassStrongBrush" Color="{StaticResource AdSurface}" Opacity="0.84" />
            <SolidColorBrush x:Key="AdTerminalCanvasBrush" Color="{StaticResource AdTermBg}" Opacity="0.92" />
            <SolidColorBrush x:Key="AdTerminalForegroundBrush" Color="{StaticResource AdTermFg}" />
            <SolidColorBrush x:Key="AdBrandBrush" Color="{StaticResource AdBrand400}" />
            <SolidColorBrush x:Key="AdAccentBrush" Color="{StaticResource AdAccent400}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="AdBrand300">#F7CE6B</Color>
            <Color x:Key="AdBrand400">#F0BE4A</Color>
            <Color x:Key="AdBrand500">#E5A82B</Color>
            <Color x:Key="AdBrand600">#C88A1C</Color>
            <Color x:Key="AdBrand700">#A06B15</Color>
            <Color x:Key="AdAccent300">#6FA06B</Color>
            <Color x:Key="AdAccent400">#5C8C58</Color>
            <Color x:Key="AdAccent500">#4E7A4E</Color>

            <Color x:Key="AdBgBase">#ECEDF0</Color>
            <Color x:Key="AdSurface">#FFFFFF</Color>
            <Color x:Key="AdSurfaceContainer">#F4F5F8</Color>
            <Color x:Key="AdSurfaceContainerHigh">#E9EBEF</Color>
            <Color x:Key="AdTermBg">#0B0C0F</Color>
            <Color x:Key="AdTermFg">#D6D9E0</Color>

            <SolidColorBrush x:Key="AdTextPrimaryBrush" Color="#0E0F12" Opacity="0.93" />
            <SolidColorBrush x:Key="AdTextSecondaryBrush" Color="#0E0F12" Opacity="0.58" />
            <SolidColorBrush x:Key="AdTextTertiaryBrush" Color="#0E0F12" Opacity="0.38" />
            <SolidColorBrush x:Key="AdBorderBrush" Color="#0E0F12" Opacity="0.13" />
            <SolidColorBrush x:Key="AdBorderStrongBrush" Color="#0E0F12" Opacity="0.20" />
            <SolidColorBrush x:Key="AdGlassBrush" Color="{StaticResource AdSurface}" Opacity="0.62" />
            <SolidColorBrush x:Key="AdGlassStrongBrush" Color="{StaticResource AdSurface}" Opacity="0.84" />
            <SolidColorBrush x:Key="AdTerminalCanvasBrush" Color="{StaticResource AdTermBg}" Opacity="0.92" />
            <SolidColorBrush x:Key="AdTerminalForegroundBrush" Color="{StaticResource AdTermFg}" />
            <SolidColorBrush x:Key="AdBrandBrush" Color="{StaticResource AdBrand600}" />
            <SolidColorBrush x:Key="AdAccentBrush" Color="{StaticResource AdAccent500}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <x:Double x:Key="AdSpace1">4</x:Double>
    <x:Double x:Key="AdSpace2">8</x:Double>
    <x:Double x:Key="AdSpace3">12</x:Double>
    <x:Double x:Key="AdSpace4">16</x:Double>
    <x:Double x:Key="AdSpace5">20</x:Double>
    <x:Double x:Key="AdSpace6">24</x:Double>

    <Thickness x:Key="AdPadPanel">20</Thickness>
    <Thickness x:Key="AdPadCompact">12</Thickness>
    <Thickness x:Key="AdPadCanvas">16</Thickness>

    <CornerRadius x:Key="AdRadiusSm">8</CornerRadius>
    <CornerRadius x:Key="AdRadiusMd">12</CornerRadius>
    <CornerRadius x:Key="AdRadiusLg">18</CornerRadius>
    <CornerRadius x:Key="AdRadiusXl">24</CornerRadius>

    <x:Double x:Key="AdFontSizeUi">13</x:Double>
    <x:Double x:Key="AdFontSizeBody">14</x:Double>
    <x:Double x:Key="AdFontSizeMonoTerm">13</x:Double>
    <x:Double x:Key="AdLineHeightMonoTerm">19</x:Double>

    <FontFamily x:Key="AdFontUi">Quicksand, Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="AdFontMono">JetBrains Mono, Cascadia Mono, Consolas</FontFamily>

</ResourceDictionary>
