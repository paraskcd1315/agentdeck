<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="AgentDeck.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:foundation="using:AgentDeck.Shell.Presentation.DesignSystem.Foundation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:panels="using:AgentDeck.Shell.Presentation.Panels.Screens"
    xmlns:screens="using:AgentDeck.Shell.Presentation.Terminal.Screens"
    xmlns:terminal="using:AgentDeck.Shell.Presentation.Terminal.Components"
    xmlns:workspace="using:AgentDeck.Shell.Presentation.Workspace.Components"
    mc:Ignorable="d">

    <Grid>
        <Rectangle x:Name="AppGradient" IsHitTestVisible="False" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TitleBar x:Name="AppTitleBar" Height="{StaticResource AdTitleHeight}">
                    <TitleBar.LeftHeader>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource AdSpace4}">
                            <workspace:WorkspaceChip x:Name="Workspace" />
                            <terminal:TerminalTabStrip x:Name="TitleTabs" VerticalAlignment="Bottom" />
                        </StackPanel>
                    </TitleBar.LeftHeader>
                </TitleBar>

                <Border
                    Height="1"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource AdStrokeBrush}"
                    IsHitTestVisible="False" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>

                <screens:TerminalScreen x:Name="Terminal" Grid.Column="0" />

                <Border
                    Grid.Column="1"
                    Background="{ThemeResource AdGlassBrush}"
                    BorderBrush="{ThemeResource AdStrokeBrush}"
                    BorderThickness="1,0,0,0">
                    <panels:PanelsPane x:Name="Panels" />
                </Border>
            </Grid>

            <Border
                Grid.Row="2"
                Height="{StaticResource AdStatusHeight}"
                Padding="{StaticResource AdPadCanvas}"
                Background="{ThemeResource AdGlassBrush}"
                BorderBrush="{ThemeResource AdStrokeBrush}"
                BorderThickness="0,1,0,0">
                <TextBlock
                    x:Name="StatusBar"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource AdFontMono}"
                    FontSize="{StaticResource AdCaptionSize}"
                    Foreground="{ThemeResource AdText3Brush}"
                    TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>
    </Grid>
</Window>
