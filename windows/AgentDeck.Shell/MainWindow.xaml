<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="AgentDeck.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:foundation="using:AgentDeck.Shell.Presentation.DesignSystem.Foundation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:panels="using:AgentDeck.Shell.Presentation.Panels.Screens"
    xmlns:screens="using:AgentDeck.Shell.Presentation.Terminal.Screens"
    xmlns:terminal="using:AgentDeck.Shell.Presentation.Terminal.Components"
    xmlns:workspace="using:AgentDeck.Shell.Presentation.Workspace.Components"
    mc:Ignorable="d">

    <Grid>
        <Rectangle x:Name="AppGradient" IsHitTestVisible="False" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="AppTitleBar"
                Grid.Row="0"
                Height="{StaticResource AdTitleHeight}"
                Background="{ThemeResource AdGlassBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <workspace:WorkspaceChip
                    x:Name="Workspace"
                    Grid.Column="0"
                    Margin="{StaticResource AdPadTitle}"
                    VerticalAlignment="Center" />

                <Border
                    x:Name="DragRegion"
                    Grid.Column="1"
                    Background="Transparent" />

                <terminal:TerminalTabStrip
                    x:Name="TitleTabs"
                    Grid.Column="1"
                    Margin="{StaticResource AdPadTabs}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch" />

                <Border x:Name="CaptionSpace" Grid.Column="2" />

                <Border
                    Grid.ColumnSpan="3"
                    Height="1"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource AdStrokeBrush}"
                    IsHitTestVisible="False" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="PanelColumn" Width="380" />
                </Grid.ColumnDefinitions>

                <screens:TerminalScreen x:Name="Terminal" Grid.Column="0" />

                <Border
                    Grid.Column="1"
                    Background="{ThemeResource AdGlassBrush}">
                    <panels:PanelsPane x:Name="Panels" />
                </Border>

                <foundation:DragDivider
                    x:Name="PanelDivider"
                    Grid.Column="1"
                    HorizontalAlignment="Left" />
            </Grid>

            <Border
                Grid.Row="2"
                Height="{StaticResource AdStatusHeight}"
                Padding="{StaticResource AdPadCanvas}"
                Background="{ThemeResource AdGlassBrush}"
                BorderBrush="{ThemeResource AdStrokeBrush}"
                BorderThickness="0,1,0,0">
                <TextBlock
                    x:Name="StatusBar"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource AdFontMono}"
                    FontSize="{StaticResource AdCaptionSize}"
                    Foreground="{ThemeResource AdText3Brush}"
                    TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>
    </Grid>
</Window>
