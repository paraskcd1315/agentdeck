<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="AgentDeck.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:foundation="using:AgentDeck.Shell.Presentation.DesignSystem.Foundation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:panels="using:AgentDeck.Shell.Presentation.Panels.Screens"
    xmlns:screens="using:AgentDeck.Shell.Presentation.Terminal.Screens"
    mc:Ignorable="d">

    <Grid>
        <Rectangle x:Name="AppGradient" IsHitTestVisible="False" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TitleBar x:Name="AppTitleBar">
                <TitleBar.IconSource>
                    <ImageIconSource ImageSource="Assets/AppIcon.ico" />
                </TitleBar.IconSource>
            </TitleBar>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>

                <screens:TerminalScreen x:Name="Terminal" Grid.Column="0" />

                <panels:PanelsPane
                    x:Name="Panels"
                    Grid.Column="1"
                    Margin="0,20,20,20" />
            </Grid>
        </Grid>
    </Grid>
</Window>
