<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="AgentDeck.Shell.Presentation.Terminal.Screens.TerminalScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource AdPadPanel}" RowSpacing="{StaticResource AdSpace3}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="{ThemeResource AdTerminalCanvasBrush}"
            BorderBrush="{ThemeResource AdBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource AdRadiusLg}">
            <ScrollViewer
                x:Name="OutputScroller"
                Padding="{StaticResource AdPadCanvas}"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <TextBlock
                    x:Name="OutputText"
                    FontFamily="{StaticResource AdFontMono}"
                    FontSize="{StaticResource AdFontSizeMonoTerm}"
                    Foreground="{ThemeResource AdTerminalForegroundBrush}"
                    IsTextSelectionEnabled="True"
                    LineHeight="{StaticResource AdLineHeightMonoTerm}"
                    TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <TextBox
            x:Name="InputBox"
            Grid.Row="1"
            FontFamily="{StaticResource AdFontMono}"
            FontSize="{StaticResource AdFontSizeMonoTerm}"
            KeyDown="OnInputKeyDown" />

        <TextBlock
            x:Name="StatusText"
            Grid.Row="2"
            FontFamily="{StaticResource AdFontUi}"
            FontSize="{StaticResource AdFontSizeUi}"
            Foreground="{ThemeResource AdTextSecondaryBrush}" />
    </Grid>
</UserControl>
