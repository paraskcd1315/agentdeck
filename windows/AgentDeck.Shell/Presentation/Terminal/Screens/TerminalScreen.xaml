<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="AgentDeck.Shell.Presentation.Terminal.Screens.TerminalScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    CharacterReceived="OnCharacterReceived"
    GotFocus="OnCanvasGotFocus"
    IsTabStop="True"
    LostFocus="OnCanvasLostFocus"
    PointerPressed="OnCanvasPointerPressed"
    PointerReleased="OnCanvasPointerReleased"
    PointerWheelChanged="OnCanvasPointerWheelChanged"
    PreviewKeyDown="OnCanvasPreviewKeyDown"
    UseSystemFocusVisuals="False"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Height="{StaticResource AdTermStripHeight}"
            Padding="{StaticResource AdPadStrip}"
            Background="{ThemeResource AdGlassBrush}"
            BorderBrush="{ThemeResource AdStrokeBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Border
                    x:Name="SessionChip"
                    Padding="12,4,12,4"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{StaticResource AdGradientSelect}"
                    CornerRadius="{StaticResource AdRadiusSm}">
                    <TextBlock
                        x:Name="SessionText"
                        FontFamily="{StaticResource AdFontUi}"
                        FontSize="{StaticResource AdCaptionSize}"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AdTextBrush}" />
                </Border>

                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="{StaticResource AdSpace4}">
                    <Button
                        x:Name="ClosePaneButton"
                        AllowFocusOnInteraction="False"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnClosePaneClick"
                        CornerRadius="{StaticResource AdRadiusSm}"
                        FontFamily="{StaticResource AdFontUi}"
                        FontSize="{StaticResource AdCaptionSize}"
                        Foreground="{ThemeResource AdText3Brush}"
                        IsTabStop="False"
                        Padding="{StaticResource AdPadStrip}"
                        Visibility="Collapsed" />

                    <Button
                        x:Name="SplitButton"
                        AllowFocusOnInteraction="False"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnSplitClick"
                        CornerRadius="{StaticResource AdRadiusSm}"
                        FontFamily="{StaticResource AdFontUi}"
                        FontSize="{StaticResource AdCaptionSize}"
                        Foreground="{ThemeResource AdText3Brush}"
                        IsTabStop="False"
                        Padding="{StaticResource AdPadStrip}" />

                    <TextBlock
                        x:Name="StripMeta"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource AdFontMono}"
                        FontSize="{StaticResource AdCaptionSize}"
                        Foreground="{ThemeResource AdText3Brush}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="CanvasHost" Grid.Row="1" />

        <Border
            Grid.Row="2"
            Height="{StaticResource AdTermFootHeight}"
            Padding="{StaticResource AdPadStrip}"
            Background="{ThemeResource AdGlassBrush}"
            BorderBrush="{ThemeResource AdStrokeBrush}"
            BorderThickness="0,1,0,0">
            <TextBlock
                x:Name="StatusText"
                VerticalAlignment="Center"
                FontFamily="{StaticResource AdFontMono}"
                FontSize="{StaticResource AdCaptionSize}"
                Foreground="{ThemeResource AdText3Brush}"
                TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</UserControl>
