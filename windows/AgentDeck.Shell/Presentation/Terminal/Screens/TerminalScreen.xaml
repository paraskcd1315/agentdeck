<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="AgentDeck.Shell.Presentation.Terminal.Screens.TerminalScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:foundation="using:AgentDeck.Shell.Presentation.DesignSystem.Foundation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource AdPadPanel}" RowSpacing="{StaticResource AdSpace3}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="{ThemeResource AdTermCanvasBrush}"
            BorderBrush="{ThemeResource AdStrokeBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource AdRadiusLg}">
            <Grid>
                <ScrollViewer
                    x:Name="OutputScroller"
                    Padding="{StaticResource AdPadCanvas}"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Auto">
                    <TextBlock
                        x:Name="OutputText"
                        FontFamily="{StaticResource AdFontMono}"
                        FontSize="{StaticResource AdMonoSize}"
                        Foreground="{ThemeResource AdTermForegroundBrush}"
                        IsTextSelectionEnabled="True"
                        LineHeight="{StaticResource AdMonoLine}"
                        TextWrapping="Wrap" />
                </ScrollViewer>

                <Border
                    Height="1"
                    Margin="1,0,1,0"
                    VerticalAlignment="Top"
                    Background="{ThemeResource AdSpecularBrush}"
                    IsHitTestVisible="False" />
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            BorderBrush="{ThemeResource AdStrokeBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource AdRadiusMd}">
            <Border.Background>
                <foundation:BackdropGlassBrush
                    BlurAmount="{StaticResource AdGlassThinBlur}"
                    Saturation="{StaticResource AdGlassThinSaturation}"
                    TintColor="{ThemeResource AdGlassThinTint}" />
            </Border.Background>
            <TextBox
                x:Name="InputBox"
                Background="Transparent"
                BorderThickness="0"
                FontFamily="{StaticResource AdFontMono}"
                FontSize="{StaticResource AdMonoSize}"
                Foreground="{ThemeResource AdTextBrush}"
                KeyDown="OnInputKeyDown" />
        </Border>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="2"
            FontFamily="{StaticResource AdFontUi}"
            FontSize="{StaticResource AdUiSize}"
            Foreground="{ThemeResource AdText2Brush}" />
    </Grid>
</UserControl>
