<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="AgentDeck.Shell.Presentation.Terminal.Screens.TerminalScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    CharacterReceived="OnCharacterReceived"
    GotFocus="OnCanvasGotFocus"
    IsTabStop="True"
    LostFocus="OnCanvasLostFocus"
    PointerPressed="OnCanvasPointerPressed"
    PointerReleased="OnCanvasPointerReleased"
    PointerWheelChanged="OnCanvasPointerWheelChanged"
    PreviewKeyDown="OnCanvasPreviewKeyDown"
    UseSystemFocusVisuals="False"
    mc:Ignorable="d">

    <Grid x:Name="CanvasHost" Background="Transparent" />
</UserControl>
