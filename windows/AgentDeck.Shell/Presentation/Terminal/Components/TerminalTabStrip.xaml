<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="AgentDeck.Shell.Presentation.Terminal.Components.TerminalTabStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsTabStop="False"
    VerticalContentAlignment="Bottom"
    mc:Ignorable="d">

    <StackPanel
        VerticalAlignment="Bottom"
        Orientation="Horizontal"
        Spacing="4">
        <StackPanel
            x:Name="TabHost"
            VerticalAlignment="Bottom"
            Orientation="Horizontal"
            Spacing="4" />

        <Button
            x:Name="AddButton"
            Width="28"
            Height="28"
            Margin="0,0,0,4"
            AllowFocusOnInteraction="False"
            Background="Transparent"
            BorderThickness="0"
            Click="OnAddClick"
            CornerRadius="{StaticResource AdRadiusSm}"
            FontFamily="{StaticResource AdFontUi}"
            FontSize="16"
            FontWeight="SemiBold"
            Foreground="{ThemeResource AdText3Brush}"
            IsTabStop="False"
            Padding="0" />
    </StackPanel>
</UserControl>
