<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="AgentDeck.Shell.Presentation.Terminal.Components.TerminalTabStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsTabStop="False"
    mc:Ignorable="d">

    <StackPanel
        Orientation="Horizontal"
        Spacing="{StaticResource AdSpace2}">
        <StackPanel
            x:Name="TabHost"
            Orientation="Horizontal"
            Spacing="{StaticResource AdSpace2}" />

        <Button
            x:Name="AddButton"
            AllowFocusOnInteraction="False"
            Background="Transparent"
            BorderBrush="{ThemeResource AdStrokeBrush}"
            BorderThickness="1"
            Click="OnAddClick"
            CornerRadius="{StaticResource AdRadiusMd}"
            FontFamily="{StaticResource AdFontUi}"
            FontSize="{StaticResource AdUiSize}"
            Foreground="{ThemeResource AdText2Brush}"
            IsTabStop="False"
            Padding="{StaticResource AdPadCompact}" />
    </StackPanel>
</UserControl>
