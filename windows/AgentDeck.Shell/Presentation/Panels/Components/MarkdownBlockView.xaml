<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="AgentDeck.Shell.Presentation.Panels.Components.MarkdownBlockView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <TextBlock
        x:Name="BodyText"
        FontFamily="{StaticResource AdFontUi}"
        FontSize="{StaticResource AdBodySize}"
        Foreground="{ThemeResource AdTextBrush}"
        LineHeight="{StaticResource AdBodyLine}"
        TextWrapping="Wrap" />
</UserControl>
