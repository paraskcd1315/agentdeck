<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="AgentDeck.Shell.Presentation.Panels.Components.UnknownBlockView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Expander
        x:Name="Host"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch">
        <Expander.Header>
            <TextBlock
                x:Name="HeaderText"
                FontFamily="{StaticResource AdFontUi}"
                FontSize="{StaticResource AdUiSize}"
                Foreground="{ThemeResource AdText2Brush}" />
        </Expander.Header>

        <ScrollViewer
            MaxHeight="220"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled">
            <TextBlock
                x:Name="RawText"
                FontFamily="{StaticResource AdFontMono}"
                FontSize="{StaticResource AdMonoSize}"
                Foreground="{ThemeResource AdText3Brush}"
                IsTextSelectionEnabled="True" />
        </ScrollViewer>
    </Expander>
</UserControl>
