<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="AgentDeck.Shell.Presentation.Panels.Components.DiffBlockView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        BorderBrush="{ThemeResource AdStrokeBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource AdRadiusSm}">
        <StackPanel>
            <Border
                Padding="{StaticResource AdPadButton}"
                Background="{ThemeResource AdGlassThinBrush}"
                BorderBrush="{ThemeResource AdStrokeBrush}"
                BorderThickness="0,0,0,1">
                <TextBlock
                    x:Name="FileText"
                    FontFamily="{StaticResource AdFontMono}"
                    FontSize="{StaticResource AdCaptionSize}"
                    Foreground="{ThemeResource AdText2Brush}"
                    TextTrimming="CharacterEllipsis" />
            </Border>

            <StackPanel x:Name="Lines" Spacing="1" />
        </StackPanel>
    </Border>
</UserControl>
