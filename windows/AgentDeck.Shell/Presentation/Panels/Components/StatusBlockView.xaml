<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="AgentDeck.Shell.Presentation.Panels.Components.StatusBlockView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AdSpace2}">
        <Ellipse
            x:Name="StateDot"
            Width="10"
            Height="10"
            VerticalAlignment="Center" />
        <TextBlock
            x:Name="StateText"
            VerticalAlignment="Center"
            FontFamily="{StaticResource AdFontUi}"
            FontSize="{StaticResource AdBodySize}"
            Foreground="{ThemeResource AdTextBrush}"
            LineHeight="{StaticResource AdBodyLine}"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
