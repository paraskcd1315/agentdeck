<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="AgentDeck.Shell.Presentation.Git.Components.ChangesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:foundation="using:AgentDeck.Shell.Presentation.DesignSystem.Foundation">

    <Border
        BorderBrush="{ThemeResource AdStrokeBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource AdRadiusLg}">
        <Border.Background>
            <foundation:BackdropGlassBrush
                BlurAmount="{StaticResource AdGlassBlur}"
                Saturation="{StaticResource AdGlassSaturation}"
                TintColor="{ThemeResource AdGlassTint}" />
        </Border.Background>

        <StackPanel Padding="{StaticResource AdPadCanvas}" Spacing="{StaticResource AdSpace3}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock
                        x:Name="TitleText"
                        FontFamily="{StaticResource AdFontUi}"
                        FontSize="{StaticResource AdH2Size}"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AdTextBrush}"
                        LineHeight="{StaticResource AdH2Line}" />
                    <TextBlock
                        x:Name="SubtitleText"
                        FontFamily="{StaticResource AdFontMono}"
                        FontSize="{StaticResource AdCaptionSize}"
                        Foreground="{ThemeResource AdText3Brush}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button
                    x:Name="RefreshButton"
                    Grid.Column="1"
                    Width="28"
                    Height="28"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnRefreshClick"
                    CornerRadius="{StaticResource AdRadiusSm}"
                    FontFamily="{StaticResource AdFontIcon}"
                    FontSize="12"
                    Foreground="{ThemeResource AdText3Brush}"
                    IsTabStop="False"
                    Padding="0" />
            </Grid>

            <Rectangle Height="1" Fill="{ThemeResource AdGradientRule}" />
            <StackPanel x:Name="EntryHost" Spacing="{StaticResource AdSpace1}" />
        </StackPanel>
    </Border>
</UserControl>
